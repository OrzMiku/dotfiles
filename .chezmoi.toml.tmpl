{{- $name := promptStringOnce . "git.name" "Git user name" | trim -}}
{{- if eq $name "" -}}
{{- fail "Git user name is required" -}}
{{- end -}}
{{- $email := promptStringOnce . "git.email" "Git user email" | trim -}}
{{- if eq $email "" -}}
{{- fail "Git user email is required" -}}
{{- end -}}
{{- $npmMirror := promptBool "Use npm mirror (npmmirror.com)" (dig "npm" "useMirror" false .) -}}

[data.git]
    name = {{ $name | quote }}
    email = {{ $email | quote }}

[data.npm]
    useMirror = {{ $npmMirror }}
