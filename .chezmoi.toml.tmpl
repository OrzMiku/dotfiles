{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $username := promptStringOnce . "username" "Username" -}}
{{- $useNpmMirror := promptBool "Use npm mirror (npmmirror.com)" false -}}

encryption = "age"

[data]
  email = {{ $email | quote }}
  username = {{ $username | quote }}
  useNpmMirror = {{ $useNpmMirror }}

[bitwarden]
  unlock="auto"

