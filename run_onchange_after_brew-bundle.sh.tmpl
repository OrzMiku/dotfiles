{{- if eq .chezmoi.os "darwin" -}}
{{- if lookPath "brew" -}}
#!/bin/bash
set -euo pipefail

BREWFILE="$(mktemp /tmp/BrewFile.XXXXXX)"
trap 'rm -f "$BREWFILE"' EXIT

cat > "$BREWFILE" <<'EOF'
tap "nikitabobko/tap"

brew "bitwarden-cli"
brew "chezmoi"
brew "fastfetch"
brew "fd"
brew "fnm"
brew "fzf"
brew "git"
brew "mergiraf"
brew "mihomo"
brew "neovim"
brew "ripgrep"
brew "starship"
brew "tmux"
brew "tree-sitter-cli"
brew "uv"
brew "zellij"
brew "zoxide"

cask "nikitabobko/tap/aerospace"
cask "chatgpt"
cask "claude"
cask "emacs-app"
cask "flclash"
cask "font-maple-mono-nf-cn"
cask "ghostty"
cask "google-chrome"
cask "helium-browser"
cask "iina"
cask "keka"
cask "localsend"
cask "mos"
cask "pearcleaner"
EOF
chmod 644 "$BREWFILE"

brew as-brew-user bundle --file="$BREWFILE"
{{ end -}}
{{ end -}}
