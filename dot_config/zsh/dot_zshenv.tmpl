typeset -U path
path=(
  "$HOME/.local/share/npm/bin"
  "$HOME/.local/bin"
  "$HOME/.comagic/bin"
  "$HOME/.opencode/bin"
  $path
)

export VISUAL=nvim
export EDITOR=nvim
export PAGER=less

{{- if lookPath "bw" }}
export OPENCODE_SERVER_PASSWORD={{- (bitwarden "item" "OpenCode Server Password").login.password | shellQuote }}
{{- end }}

if [[ -r "$HOME/.local/share/bob/env/env.sh" ]]; then
  source "$HOME/.local/share/bob/env/env.sh"
fi

if [[ -r "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi
